<Project Sdk="Microsoft.NET.Sdk">

    <Sdk Name="Aspire.AppHost.Sdk" Version="9.5.1" />
    
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net9.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Description>.NET Aspire AppHost: loads single-source manifest and prints normalized resource details for selected targets; supports profile overlays and resource filtering.</Description>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.AppHost" Version="9.5.1" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\ManifestBridge\ManifestBridge.csproj" IsAspireProjectResource="false" />
    </ItemGroup>
</Project>