{
  "schemaVersion": "0.1",
  "resources": {
    "firecrawl-redis": {
      "type": "container.v0",
      "properties": {
        "image": "redis:alpine",
        "bindings": [
          {
            "name": "redis",
            "protocol": "tcp",
            "containerPort": 6379,
            "hostPort": 6379
          }
        ],
        "volumes": [
          {
            "name": "firecrawl-redis-data",
            "containerPath": "/data",
            "type": "named"
          }
        ],
        "networks": [
          {
            "name": "firecrawl-net",
            "alias": "firecrawl-redis"
          }
        ],
        "environment": {
          "REDIS_ARGS": "--appendonly yes"
        },
        "restart": "always",
        "resources": {
          "memory": "256m"
        }
      }
    },
    "firecrawl-postgres": {
      "type": "container.v0",
      "properties": {
        "image": "postgres:16-alpine",
        "volumes": [
          {
            "name": "firecrawl-postgres-data",
            "containerPath": "/var/lib/postgresql/data",
            "type": "named"
          }
        ],
        "networks": [
          {
            "name": "firecrawl-net",
            "alias": "firecrawl-postgres"
          }
        ],
        "environment": {
          "POSTGRES_DB": "firecrawl",
          "POSTGRES_USER": "firecrawl",
          "POSTGRES_PASSWORD": "change-me",
          "PGDATA": "/var/lib/postgresql/data"
        },
        "restart": "always",
        "resources": {
          "memory": "512m"
        }
      }
    },
    "firecrawl-worker": {
      "type": "container.v0",
      "properties": {
        "image": "ghcr.io/firecrawl/firecrawl:latest",
        "volumes": [
          {
            "name": "firecrawl-worker-data",
            "containerPath": "/app/data",
            "type": "named"
          }
        ],
        "networks": [
          {
            "name": "firecrawl-net",
            "alias": "firecrawl-worker"
          }
        ],
        "environment": {
          "NUM_WORKERS_PER_QUEUE": "8",
          "REDIS_URL": "redis://firecrawl-redis:6379",
          "REDIS_RATE_LIMIT_URL": "redis://firecrawl-redis:6379",
          "REDIS_PORT": "6379",
          "PLAYWRIGHT_MICROSERVICE_URL": "http://playwright-service:3010/html",
          "DATABASE_URL": "postgres://firecrawl:change-me@firecrawl-postgres:5432/firecrawl",
          "PGHOST": "firecrawl-postgres",
          "PGPORT": "5432",
          "PGUSER": "firecrawl",
          "PGPASSWORD": "change-me",
          "PGDATABASE": "firecrawl",
          "PGSSLMODE": "disable",
          "NUQ_REDUCE_NOISE": "true",
          "NUQ_WORKER_PORT": "3009",
          "USE_DB_AUTHENTICATION": "false",
          "OPENAI_API_KEY": "dummy"
        },
        "restart": "always",
        "resources": {
          "memory": "512m"
        },
        "dependencies": [
          "firecrawl-postgres",
          "firecrawl-redis",
          "playwright-service"
        ],
        "command": [
          "node",
          "dist/src/services/worker/nuq-worker.js"
        ]
      }
    },
    "firecrawl-api": {
      "type": "container.v0",
      "properties": {
        "image": "ghcr.io/firecrawl/firecrawl:latest",
        "bindings": [
          {
            "name": "http",
            "protocol": "tcp",
            "containerPort": 3002,
            "hostPort": 3002
          }
        ],
        "volumes": [
          {
            "name": "firecrawl-api-data",
            "containerPath": "/app/data",
            "type": "named"
          }
        ],
        "networks": [
          {
            "name": "firecrawl-net",
            "alias": "firecrawl-api"
          }
        ],
        "environment": {
          "NUM_WORKERS_PER_QUEUE": "8",
          "PORT": "3002",
          "HOST": "0.0.0.0",
          "REDIS_URL": "redis://firecrawl-redis:6379",
          "REDIS_RATE_LIMIT_URL": "redis://firecrawl-redis:6379",
          "REDIS_PORT": "6379",
          "PLAYWRIGHT_MICROSERVICE_URL": "http://playwright-service:3010/html",
          "USE_DB_AUTHENTICATION": "false",
          "NUQ_DATABASE_URL": "postgres://firecrawl:change-me@firecrawl-postgres:5432/firecrawl",
          "DATABASE_URL": "postgres://firecrawl:change-me@firecrawl-postgres:5432/firecrawl",
          "PGHOST": "firecrawl-postgres",
          "PGPORT": "5432",
          "PGUSER": "firecrawl",
          "PGPASSWORD": "change-me",
          "PGDATABASE": "firecrawl",
          "PGSSLMODE": "disable",
          "SUPABASE_ANON_TOKEN": "",
          "SUPABASE_URL": "",
          "SUPABASE_SERVICE_TOKEN": "",
          "OPENAI_API_KEY": "dummy"
        },
        "restart": "always",
        "resources": {
          "memory": "1024m"
        },
        "dependencies": [
          "firecrawl-postgres",
          "firecrawl-redis",
          "playwright-service"
        ],
        "command": [
          "node",
          "dist/src/index.js"
        ]
      }
    },
    "playwright-service": {
      "type": "container.v0",
      "properties": {
        "image": "mcr.microsoft.com/playwright:latest",
        "bindings": [
          {
            "name": "http",
            "protocol": "tcp",
            "containerPort": 3010,
            "hostPort": 3010
          }
        ],
        "volumes": [
          {
            "name": "playwright-service-data",
            "containerPath": "/app/data",
            "type": "named"
          }
        ],
        "networks": [
          {
            "name": "firecrawl-net",
            "alias": "playwright-service"
          }
        ],
        "environment": {
          "PORT": "3010"
        },
        "restart": "always",
        "resources": {
          "memory": "512m"
        },
        "command": [
          "node",
          "-e",
          "const http = require('http'); const server = http.createServer((req, res) => { if (req.url === '/health') { res.writeHead(200, {'Content-Type': 'application/json'}); res.end(JSON.stringify({status: 'ok', service: 'playwright'})); } else { res.writeHead(404); res.end('Not Found'); } }); server.listen(3010, '0.0.0.0', () => console.log('Playwright service listening on port 3010'));"
        ]
      }
    },
    "n8n": {
      "type": "container.v0",
      "properties": {
        "image": "docker.io/n8nio/n8n:2.6.3",
        "bindings": [
          {
            "name": "http",
            "protocol": "tcp",
            "containerPort": 5678,
            "hostPort": 5678
          }
        ],
        "volumes": [
          {
            "name": "n8n-data",
            "containerPath": "/home/node/.n8n",
            "type": "named"
          }
        ],
        "environment": {
          "GENERIC_TIMEZONE": "Europe/London",
          "TZ": "Europe/London",
          "N8N_COMMUNITY_PACKAGES_ENABLED": "true",
          "N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE": "true",
          "N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS": "true",
          "N8N_TRUST_HOST_HEADERS": "true",
          "N8N_LOG_LEVEL": "info",
          "N8N_LOG_OUTPUT": "console,file",
          "N8N_LOG_FILE_LOCATION": "/home/node/.n8n/logs/n8n.log",
          "N8N_LOG_FILE_MAX_SIZE": "100",
          "N8N_LOG_FILE_MAX_COUNT": "30",
          "NODE_OPTIONS": "--max-old-space-size=12288",
          "NODES_EXCLUDE": "[]",
          "N8N_RUNNERS_DISABLED_RUNNERS": "python"
        },
        "restart": "always",
        "networkMode": "host",
        "resources": {
          "memory": "14g",
          "memorySwap": "14g"
        },
        "additionalHosts": {
          "host.local": "127.0.0.1"
        },
        "corporateCerts": {
          "hostPemFile": "Files/trusted_root_certificates.pem",
          "vmPath": "/etc/pki/ca-trust/source/anchors/corporate_ca.pem",
          "containerPath": "/etc/ssl/certs/corporate_ca.pem",
          "envVars": {
            "NODE_EXTRA_CA_CERTS": "/etc/ssl/certs/corporate_ca.pem"
          }
        }
      }
    },
    "qdrant": {
      "type": "container.v0",
      "properties": {
        "image": "qdrant/qdrant",
        "bindings": [
          {
            "name": "http",
            "protocol": "tcp",
            "containerPort": 6333,
            "hostPort": 6333
          },
          {
            "name": "grpc",
            "protocol": "tcp",
            "containerPort": 6334,
            "hostPort": 6334
          }
        ],
        "volumes": [
          {
            "name": "qdrant-data",
            "containerPath": "/qdrant/storage",
            "type": "named"
          }
        ],
        "restart": "always"
      }
    },
    "pipelines": {
      "type": "container.v0",
      "properties": {
        "image": "ghcr.io/open-webui/pipelines:main",
        "bindings": [
          {
            "name": "http",
            "protocol": "tcp",
            "containerPort": 9099,
            "hostPort": 9099
          }
        ],
        "volumes": [
          {
            "name": "pipelines",
            "containerPath": "/app/pipelines",
            "type": "named"
          }
        ],
        "environment": {},
        "restart": "always",
        "additionalHosts": {
          "host.docker.internal": "host-gateway"
        }
      }
    },
    "open-webui": {
      "type": "container.v0",
      "properties": {
        "image": "ghcr.io/open-webui/open-webui:main",
        "bindings": [
          {
            "name": "http",
            "protocol": "tcp",
            "containerPort": 8080,
            "hostPort": 3000
          }
        ],
        "volumes": [
          {
            "name": "open-webui-data",
            "containerPath": "/app/backend/data",
            "type": "named"
          }
        ],
        "environment": {},
        "restart": "always",
        "additionalHosts": {
          "host.docker.internal": "host-gateway"
        },
        "platform": "linux/amd64"
      }
    },
    "qwen3-embedding-4b": {
      "type": "container.v0",
      "properties": {
        "image": "ollama/ollama:latest",
        "bindings": [
          {
            "name": "http",
            "protocol": "tcp",
            "containerPort": 11434,
            "hostPort": 8001
          }
        ],
        "volumes": [
          {
            "name": "qwen3-embedding-4b-data",
            "containerPath": "/root/.ollama",
            "type": "named"
          }
        ],
        "environment": {
          "OLLAMA_MODEL": "qwen3-embedding:4b"
        },
        "restart": "always"
      }
    },
    "qdrant-mcp-server": {
      "type": "container.v0",
      "properties": {
        "image": "qdrant-mcp-server:latest",
        "bindings": [
          {
            "name": "http",
            "protocol": "tcp",
            "containerPort": 8000,
            "hostPort": 8000
          }
        ],
        "volumes": [
          {
            "name": "qdrant-mcp-server-data",
            "containerPath": "/app/data",
            "type": "named"
          }
        ],
        "environment": {
          "QDRANT_URL": "http://host.containers.internal:6333",
          "COLLECTION_NAME": "mcp-default-collection"
        },
        "restart": "always"
      }
    },
    "cloudbeaver": {
      "type": "container.v0",
      "properties": {
        "image": "dbeaver/cloudbeaver:latest",
        "bindings": [
          {
            "name": "http",
            "protocol": "tcp",
            "containerPort": 8978,
            "hostPort": 8978
          }
        ],
        "volumes": [
          {
            "name": "cloudbeaver_conf",
            "containerPath": "/opt/cloudbeaver/conf",
            "type": "named"
          },
          {
            "name": "cloudbeaver_workspace",
            "containerPath": "/opt/cloudbeaver/workspace",
            "type": "named"
          }
        ],
        "environment": {
          "TZ": "Europe/London"
        },
        "restart": "always"
      }
    }
  }
}
