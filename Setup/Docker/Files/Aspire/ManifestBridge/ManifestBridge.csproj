<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net9.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Description>Aspire ManifestBridge: parses single-source manifest and applies optional profile overlays; exposes merge helpers and model for AppHost/tests.</Description>
        <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <PropertyGroup>
        <AssemblyName>ManifestBridge</AssemblyName>
        <RootNamespace>ManifestBridge</RootNamespace>
    </PropertyGroup>
</Project>