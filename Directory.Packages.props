<Project>
  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <!--<DisablePackageUpgrade>true</DisablePackageUpgrade>-->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
    <!-- https://learn.microsoft.com/en-us/nuget/concepts/package-versioning?tabs=semver20sort#version-ranges -->
    <MaxDnVersion>11.0.0</MaxDnVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.10" />
    <!-- OpenAI Packages -->
    <PackageVersion Include="OpenAI" Version="2.4.0" />
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.3.0-beta.2" />
    <!-- Other Packages -->
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <PackageVersion Include="Microsoft.ML" Version="5.0.0" />
    <PackageVersion Include="Azure.Core" Version="1.60.0" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Graph" Version="6.2.0" />
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.87.0" />
    <PackageVersion Include="Azure.ResourceManager" Version="1.14.0" />
    <PackageVersion Include="bblanchon.PDFium.Linux" Version="152.0.7961" />
    <PackageVersion Include="bblanchon.PDFium.macOS" Version="152.0.7961" />
    <PackageVersion Include="bblanchon.PDFium.Win32" Version="152.0.7961" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageVersion Include="ColorCode.HTML" Version="2.0.15" />
    <PackageVersion Include="CsvHelper" Version="33.1.0" />
    <PackageVersion Include="DiffPlex.Wpf" Version="1.9.1" />
    <PackageVersion Include="DnsClient" Version="1.8.0" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="GeoCoordinate.NetCore" Version="1.0.0.1" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageVersion Include="HtmlRenderer.PdfSharp.NetStandard2" Version="1.5.1.3" />
    <PackageVersion Include="Ignore" Version="0.2.1" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Extensions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.CognitiveServices.Speech" Version="1.51.1" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.13.2" />
    <PackageVersion Include="Microsoft.Identity.Web.UI" Version="4.13.2" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.21.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.9.0" />
    <!-- Microsoft.OpenApi.Readers is discontinued; its reader moved into Microsoft.OpenApi
         and YAML support now lives in the separately versioned YamlReader package. -->
    <PackageVersion Include="Microsoft.OpenApi.YamlReader" Version="3.9.0" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageVersion Include="Microsoft.Windows.Compatibility" Version="10.0.10" />
    <PackageVersion Include="NAudio" Version="2.3.0" />
    <PackageVersion Include="NJsonSchema" Version="11.6.1" />
    <PackageVersion Include="NPOI" Version="2.8.0" />
    <PackageVersion Include="PdfPig" Version="0.1.15" />
    <PackageVersion Include="PDFtoImage" Version="5.2.1" />
    <PackageVersion Include="RtfPipe" Version="2.0.7677.4303" />
    <PackageVersion Include="SharpVectors" Version="1.8.5" />
    <!-- Do not move to 4.x: it fails the build unless a paid Six Labors license key is supplied. -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageVersion Include="SkiaSharp" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.150.1" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.4" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageVersion Include="System.Composition" Version="10.0.10" />
    <PackageVersion Include="System.Data.Odbc" Version="10.0.10" />
    <PackageVersion Include="System.Data.OleDb" Version="10.0.10" />
    <PackageVersion Include="System.Data.OracleClient" Version="1.0.8" />
    <PackageVersion Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
    <PackageVersion Include="System.Linq.Async" Version="6.0.1" />
    <PackageVersion Include="Tiktoken" Version="3.1.5" />
    <PackageVersion Include="Unofficial.Microsoft.mshtml.NetStandard" Version="7.0.3300.2" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- MCP Support -->
    <PackageVersion Include="ModelContextProtocol" Version="1.4.1" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="1.4.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- Version Conflict Workaround: Transitive Packages -->
    <PackageVersion Include="System.CodeDom" Version="10.0.10" />
    <PackageVersion Include="Microsoft.ServiceHub.Framework" Version="4.8.55" />
    <PackageVersion Include="StreamJsonRpc" Version="2.22.11" />
  </ItemGroup>
  <ItemGroup>
    <!-- Security Workaround: Transitive Packages -->
    <PackageVersion Include="MessagePack" Version="3.1.3" />
    <PackageVersion Include="System.Private.Uri" Version="4.3.2" />
    <PackageVersion Include="Microsoft.IO.Redist" Version="6.0.1" />
  </ItemGroup>
</Project>